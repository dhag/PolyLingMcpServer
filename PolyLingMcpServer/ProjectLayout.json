  "McpServerSource": "データとツール/ツール/PolyLingMcpServer/PolyLingMcpServer",
  "BuildConfig": "Assets/PolyLingBuild/ビルド構成.json",
  "DefaultBuildConfig": "Packages/com.haglib.polyling/Editor/Build/既定ビルド構成.json",
